<Window x:Class="MozChecker.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Moz Checker" Width="1440" Height="900" MinWidth="1040" MinHeight="700" WindowStartupLocation="CenterScreen">
 <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,8"><Button Content="Pengaturan API / aturan" DockPanel.Dock="Right" Click="SettingsClick"/><StackPanel Orientation="Horizontal"><Button x:Name="ImportButton" Content="Impor CSV / TXT / TSV…" Click="ImportClick"/><Button Content="Input baru" Click="ClearInputClick" Margin="6,0"/><Button x:Name="StartButton" Content="Mulai pemeriksaan" Click="StartClick" Margin="0,0,16,0"/><Button x:Name="PauseButton" Content="Jeda" Click="PauseClick"/><Button x:Name="ResumeButton" Content="Lanjutkan" Click="ResumeClick" Margin="6,0"/><Button x:Name="RetryButton" Content="Ulang sumber gagal" Click="RetryClick"/></StackPanel></DockPanel>
  <Expander Grid.Row="1" x:Name="InputPanel" Header="Input domain" IsExpanded="True" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions><StackPanel Margin="0,4,12,0"><TextBlock x:Name="InputLabel" Text="Tempel domain di bawah, atau impor file. Satu daftar menjadi satu pemeriksaan." Margin="0,0,0,4"/><TextBox x:Name="DomainInput" AcceptsReturn="True" Height="105" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" TextChanged="InputChanged" AutomationProperties.Name="Daftar domain"/><TextBlock x:Name="InputFeedback" Text="Belum ada daftar input." TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><GroupBox Grid.Column="1" Header="Generator domain"><StackPanel Margin="8"><TextBox x:Name="Keywords" ToolTip="Kata kunci, pisahkan dengan koma" AutomationProperties.Name="Kata kunci generator"/><TextBox x:Name="Tlds" Text="com, net, org" Margin="0,4" ToolTip="TLD" AutomationProperties.Name="TLD generator"/><Button Content="Buat daftar" Click="GenerateClick"/></StackPanel></GroupBox></Grid></Expander>
  <Grid Grid.Row="2" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Label Content="Tampilan:" Target="{Binding ElementName=Jobs}"/><ComboBox Grid.Column="1" x:Name="Jobs" SelectionChanged="JobsChanged" AutomationProperties.Name="Cakupan hasil dan progres"/><TextBlock Grid.Column="2" x:Name="QuotaText" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="Anggaran lokal, bukan saldo dari Moz"/></Grid>
  <StackPanel Grid.Row="3" Margin="0,0,0,8"><TextBlock x:Name="ProgressText" Text="Total 0 · Selesai 0 · Belum selesai 0" FontWeight="SemiBold"/><ProgressBar x:Name="Progress" Height="12" Margin="0,6,0,4"/><TextBlock x:Name="SessionStatus" Text="Tidak ada pemeriksaan aktif." TextWrapping="Wrap"/><TextBlock x:Name="ResultSummary" Margin="0,4,0,0" Text="Available 0 · Registered 0 · Riwayat lolos 0"/></StackPanel>
  <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TabControl x:Name="ResultTabs" SelectionChanged="TabChanged" Height="32"><TabItem x:Name="AvailableTab" Header="Available"/><TabItem x:Name="OtherTab" Header="Hasil lainnya"/><TabItem x:Name="QueueTab" Header="Antrean / proses"/><TabItem x:Name="EventsTab" Header="Log kejadian"/></TabControl><DockPanel Grid.Row="1" Margin="0,8"><Button x:Name="ExportButton" Content="Ekspor semua hasil sesuai filter…" Click="ExportClick" DockPanel.Dock="Right" IsEnabled="False"/><Button Content="Terbaru" Click="LatestClick" DockPanel.Dock="Right" Margin="6,0"/><Button Content="Reset" Click="ResetClick" DockPanel.Dock="Right" Margin="6,0,0,0"/><Button x:Name="FilterButton" Content="Filter…" Click="FilterClick" DockPanel.Dock="Right" Margin="6,0,0,0"/><Label Content="Cari domain:" Target="{Binding ElementName=Search}"/><TextBox x:Name="Search" TextChanged="SearchChanged" AutomationProperties.Name="Cari domain dalam seluruh cakupan, bukan halaman ini saja"/></DockPanel></Grid>
  <Grid Grid.Row="5"><DataGrid x:Name="ResultsGrid" MouseDoubleClick="EvidenceClick" PreviewKeyDown="GridKeyDown" Sorting="SortChanged" AutomationProperties.Name="Hasil pemeriksaan"/><DataGrid x:Name="LogGrid" Visibility="Collapsed" CanUserSortColumns="False" AutomationProperties.Name="Log kejadian aktual, terbaru di atas"><DataGrid.Columns><DataGridTextColumn Header="Waktu komputer" Binding="{Binding LocalTime}" Width="235"/><DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="70"/><DataGridTextColumn Header="Pemeriksaan" Binding="{Binding Session}" Width="100"/><DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="180"/><DataGridTextColumn Header="Tahap" Binding="{Binding Stage}" Width="105"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/><DataGridTextColumn Header="Kejadian" Binding="{Binding Message}" Width="*" MinWidth="250"/></DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyState" Text="Belum ada hasil." Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16" IsHitTestVisible="False"/></Grid>
  <DockPanel Grid.Row="6" Margin="0,8"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="PreviousButton" Content="Sebelumnya" Click="PreviousClick"/><TextBlock x:Name="PageText" VerticalAlignment="Center" Margin="12,0"/><Button x:Name="NextButton" Content="Berikutnya" Click="NextClick"/></StackPanel><Button x:Name="EvidenceButton" Content="Detail / bukti domain" Click="EvidenceClick" HorizontalAlignment="Left" IsEnabled="False"/></DockPanel>
  <Border Grid.Row="7" BorderBrush="#BBBBBB" BorderThickness="0,1,0,0" Padding="0,6,0,0"><StackPanel><TextBlock x:Name="ViewStatus" Text="Antrean terpisah dari log. Log hanya mencatat kejadian yang sudah terjadi." TextWrapping="Wrap"/><TextBlock Text="Available perlu dikonfirmasi lagi di registrar sebelum membeli. Riwayat dinilai dari sampel." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/></StackPanel></Border>
 </Grid>
</Window>
