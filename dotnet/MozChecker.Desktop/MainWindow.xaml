<Window x:Class="MozChecker.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Moz Checker" Width="1440" Height="900" MinWidth="1040" MinHeight="700" WindowStartupLocation="CenterScreen">
 <Grid Margin="24,20,24,14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ImportButton" Content="Impor daftar…" ToolTip="CSV, TXT atau TSV · Ctrl+O" Click="ImportClick"/><Button x:Name="NewInputButton" Content="Daftar baru" Click="ClearInputClick" Margin="8,0"/><Button x:Name="SettingsButton" Content="Pengaturan" ToolTip="API key, concurrency, dan aturan · Ctrl+," Click="SettingsClick"/></StackPanel><StackPanel Orientation="Horizontal"><Border Background="{StaticResource AccentBrush}" CornerRadius="5" Width="38" Height="38" Margin="0,0,12,0"><TextBlock Text="MC" Foreground="White" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="Moz Checker" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="DOMAIN RESEARCH" Foreground="{StaticResource MutedBrush}" FontSize="10"/></StackPanel></StackPanel></DockPanel>
  <Border Grid.Row="1" x:Name="ResumeBanner" Visibility="Collapsed" Background="#EAF0FA" BorderBrush="#C4D4EF" BorderThickness="1" CornerRadius="5" Padding="16,12" Margin="0,0,0,14"><DockPanel><Button x:Name="ResumeButton" DockPanel.Dock="Right" Content="Lanjutkan pemeriksaan" Style="{StaticResource PrimaryButton}" Click="ResumeClick" Margin="20,0,0,0" VerticalAlignment="Center"/><StackPanel><TextBlock x:Name="ResumeTitle" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="ResumeHint" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
  <Expander Grid.Row="2" x:Name="InputPanel" Header="Daftar domain baru" IsExpanded="True" Margin="0,0,0,14"><Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="16" Margin="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,20,0"><TextBlock x:Name="InputLabel" Text="Tempel domain atau impor file. Seluruh daftar disimpan sebagai satu pemeriksaan." Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/><TextBox x:Name="DomainInput" AcceptsReturn="True" Height="105" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" FontFamily="Consolas" TextChanged="InputChanged" AutomationProperties.Name="Daftar domain"/><DockPanel Margin="0,10,0,0"><Button x:Name="StartButton" DockPanel.Dock="Right" Content="Mulai pemeriksaan" Style="{StaticResource PrimaryButton}" Click="StartClick" Margin="16,0,0,0"/><TextBlock x:Name="InputFeedback" Text="Belum ada daftar input." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="GENERATOR DOMAIN" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource MutedBrush}"/><Label Content="Kata kunci" Target="{Binding ElementName=Keywords}"/><TextBox x:Name="Keywords" AutomationProperties.Name="Kata kunci generator"/><Label Content="TLD" Target="{Binding ElementName=Tlds}"/><DockPanel><Button x:Name="GenerateButton" Content="Buat daftar" Click="GenerateClick" DockPanel.Dock="Right" Margin="8,0,0,0"/><TextBox x:Name="Tlds" Text="com, net, org" AutomationProperties.Name="TLD generator"/></DockPanel></StackPanel></Grid></Border></Expander>
  <Grid Grid.Row="3" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Label Content="Pemeriksaan" Target="{Binding ElementName=Jobs}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="Jobs" SelectionChanged="JobsChanged" AutomationProperties.Name="Cakupan hasil dan progres"/><Button Grid.Column="2" x:Name="PauseButton" Content="Jeda proses" Click="PauseClick" Margin="12,0,0,0"/></Grid>
  <StackPanel Grid.Row="4" Margin="0,0,0,16"><DockPanel><TextBlock x:Name="ProgressPercent" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><TextBlock x:Name="ProgressText" Text="Belum ada pemeriksaan" FontWeight="SemiBold"/></DockPanel><ProgressBar x:Name="Progress" Height="5" Foreground="{StaticResource AccentBrush}" Background="#DFE5EE" BorderThickness="0" Margin="0,8,0,8"/><TextBlock x:Name="SessionStatus" Text="Impor daftar untuk memulai pemeriksaan." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/><DockPanel Margin="0,6,0,0"><TextBlock x:Name="QuotaText" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="12" ToolTip="Anggaran lokal, bukan saldo dari Moz"/><TextBlock x:Name="ResultSummary" Text="Available 0 · Registered 0 · Riwayat lolos 0" Foreground="{StaticResource MutedBrush}"/></DockPanel></StackPanel>
  <Border Grid.Row="5" Background="White" BorderBrush="#DEE4EC" BorderThickness="1,1,1,0" CornerRadius="5,5,0,0"><StackPanel><Border BorderBrush="#E1E6EE" BorderThickness="0,0,0,1"><TabControl Style="{StaticResource WorkspaceTabs}" SelectedIndex="0" x:Name="ResultTabs" SelectionChanged="TabChanged"><TabItem x:Name="AvailableTab" Header="Available"/><TabItem x:Name="OtherTab" Header="Hasil lainnya"/><TabItem x:Name="QueueTab" Header="Antrean / proses"/><TabItem x:Name="EventsTab" Header="Log kejadian"/></TabControl></Border><DockPanel Margin="12,10"><Button x:Name="ExportButton" Content="Ekspor CSV…" ToolTip="Seluruh hasil sesuai filter, semua halaman" Click="ExportClick" DockPanel.Dock="Right" IsEnabled="False" Margin="12,0,0,0"/><Button x:Name="RetryButton" Content="Ulang sumber gagal" Click="RetryClick" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button x:Name="LatestButton" Content="Terbaru" Click="LatestClick" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button Content="Reset" Click="ResetClick" DockPanel.Dock="Right" Margin="8,0,0,0"/><Button x:Name="FilterButton" Content="Filter…" Click="FilterClick" DockPanel.Dock="Right" Margin="8,0,0,0"/><Label Content="Cari" Target="{Binding ElementName=Search}" VerticalAlignment="Center"/><TextBox x:Name="Search" TextChanged="SearchChanged" AutomationProperties.Name="Cari domain dalam seluruh cakupan"/></DockPanel></StackPanel></Border>
  <Border Grid.Row="6" Background="White" BorderBrush="#DEE4EC" BorderThickness="1,0,1,1"><Grid><DataGrid x:Name="ResultsGrid" MouseDoubleClick="EvidenceClick" PreviewKeyDown="GridKeyDown" Sorting="SortChanged" AutomationProperties.Name="Hasil pemeriksaan"/><DataGrid x:Name="LogGrid" Visibility="Collapsed" CanUserSortColumns="False" AutomationProperties.Name="Log kejadian aktual, terbaru di atas"><DataGrid.Columns><DataGridTextColumn Header="Waktu komputer" Binding="{Binding LocalTime}" Width="235"/><DataGridTextColumn Header="#" Binding="{Binding Sequence}" Width="70"/><DataGridTextColumn Header="Pemeriksaan" Binding="{Binding Session}" Width="100"/><DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="180"/><DataGridTextColumn Header="Tahap" Binding="{Binding Stage}" Width="105"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="105"/><DataGridTextColumn Header="Kejadian" Binding="{Binding Message}" Width="*" MinWidth="250"/></DataGrid.Columns></DataGrid><TextBlock x:Name="EmptyState" Text="Belum ada hasil." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="16" IsHitTestVisible="False"/></Grid></Border>
  <DockPanel Grid.Row="7" Margin="0,10"><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="PreviousButton" Content="Sebelumnya" Click="PreviousClick"/><TextBlock x:Name="PageText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="12,0"/><Button x:Name="NextButton" Content="Berikutnya" Click="NextClick"/></StackPanel><Button x:Name="EvidenceButton" Content="Detail domain" Click="EvidenceClick" HorizontalAlignment="Left" IsEnabled="False"/></DockPanel>
  <StackPanel Grid.Row="8"><TextBlock x:Name="OperationStatus" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/><TextBlock x:Name="ViewStatus" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="Hasil tersimpan lokal. Antrean dan log kejadian ditampilkan terpisah." TextWrapping="Wrap"/><TextBlock Text="Available perlu dikonfirmasi lagi di registrar. Riwayat dinilai dari sampel." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/></StackPanel>
 </Grid>
</Window>
