<Application x:Class="MozChecker.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="CanvasBrush" Color="#F5F5F5"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#ECECEC"/>
  <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="TextBrush" Color="#202020"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#555555"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#888888"/>
  <SolidColorBrush x:Key="ErrorBrush" Color="#B00020"/>
  <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource CanvasBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="Label"><Setter Property="Padding" Value="0,6,8,4"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="10,4"/><Setter Property="MinHeight" Value="30"/></Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4"/><Setter Property="MinHeight" Value="28"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="6,4"/><Setter Property="MinHeight" Value="28"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="28"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="RowHeight" Value="28"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F5F7FA"/><Setter Property="SelectionMode" Value="Single"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="6,2"/></Style>
 </Application.Resources>
</Application>
